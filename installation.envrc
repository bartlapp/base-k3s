strict_env
export WORK_DIR="$PWD"
export VALUES="$WORK_DIR/installation.yaml"
watch_file "$VALUES"
CUSTOMER_ID=$(yq -er '.customer' "$VALUES")
INSTALLATION_ID=$(yq -er '.installation' "$VALUES")
BASE_DOMAIN=$(yq -er '.dns.root' "$VALUES")
export CUSTOMER_ID INSTALLATION_ID BASE_DOMAIN
STORE_NAME=$(yq -r '.credentials.passStore // ""' "$VALUES")
export PASSWORD_STORE_DIR=/dev/null
if [ -n "$STORE_NAME" ]; then
  [[ "$STORE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
  export PASSWORD_STORE_DIR="$(dirname "$WORK_DIR")/$STORE_NAME"
fi
unset CLUSTER_ID CLUSTER_WORK_DIR VM_ID VM_NAME PROVIDER KUBE_CONTEXT
unset ID IPV4_ID IPV6_ID FIREWALL_ID LOCATION SERVER_TYPE
unset DEPLOYMENT INSTANCE NS RELEASE PACKAGE PACKAGE_VERSION CHART_REF INSTALL_DIR CHART
export KUBECONFIG=/dev/null

load_cluster() {
  unset DEPLOYMENT INSTANCE NS RELEASE PACKAGE PACKAGE_VERSION CHART_REF INSTALL_DIR CHART
  unset VM_ID VM_NAME PROVIDER ID IPV4_ID IPV6_ID FIREWALL_ID LOCATION SERVER_TYPE KUBE_CONTEXT
  export CLUSTER_ID="$1"
  export CLUSTER_WORK_DIR="$WORK_DIR/clusters/$CLUSTER_ID/base"
  export KUBECONFIG="$CLUSTER_WORK_DIR/kubeconfig"
  KUBE_CONTEXT=$(yq -er '.clusters[strenv(CLUSTER_ID)].kubeconfig.context' "$VALUES") || return 1
  export KUBE_CONTEXT
}

load_hetzner() {
  unset VM_ID VM_NAME PROVIDER ID IPV4_ID IPV6_ID FIREWALL_ID LOCATION SERVER_TYPE
  VM_ID=$(yq -er '.clusters[strenv(CLUSTER_ID)] | select(.management == "self-managed") |
    .nodes | select(length == 1) | keys | .[0]' "$VALUES") || return 1
  export VM_ID
  PROVIDER=$(yq -er '.vms[strenv(VM_ID)].provider' "$VALUES") || return 1
  export PROVIDER
  yq -e '.providers[strenv(PROVIDER)].type == "hetzner"' "$VALUES" >/dev/null || return 1
  VM_NAME=$(yq -er '.vms[strenv(VM_ID)].configuration.name' "$VALUES") || return 1
  LOCATION=$(yq -er '.vms[strenv(VM_ID)].configuration.location' "$VALUES") || return 1
  SERVER_TYPE=$(yq -er '.vms[strenv(VM_ID)].configuration.serverType' "$VALUES") || return 1
  export VM_NAME LOCATION SERVER_TYPE
  ID=$(yq -r '.vms[strenv(VM_ID)].observed.server.id // ""' "$VALUES")
  IPV4_ID=$(yq -r '.vms[strenv(VM_ID)].observed.primaryIPv4.id // ""' "$VALUES")
  IPV6_ID=$(yq -r '.vms[strenv(VM_ID)].observed.primaryIPv6.id // ""' "$VALUES")
  FIREWALL_ID=$(yq -r '.clusters[strenv(CLUSTER_ID)].observed.firewalls.admin.id // ""' "$VALUES")
  export ID IPV4_ID IPV6_ID FIREWALL_ID
}

load_deployment() {
  unset DEPLOYMENT INSTANCE NS RELEASE PACKAGE PACKAGE_VERSION CHART_REF INSTALL_DIR CHART
  if [ "$#" -ne 1 ] || [ -z "${1:-}" ] || [ -z "${CLUSTER_ID:-}" ]; then
    printf '%s\n' 'load_deployment requires a deployment ID and loaded cluster context' >&2
    return 1
  fi
  export DEPLOYMENT="$1"
  local deployment_cluster
  deployment_cluster=$(yq -er '.deployments[strenv(DEPLOYMENT)].cluster | select(. != "")' "$VALUES") || return 1
  if [ "$deployment_cluster" != "$CLUSTER_ID" ]; then
    printf 'Deployment %s belongs to cluster %s, not %s\n' "$DEPLOYMENT" "$deployment_cluster" "$CLUSTER_ID" >&2
    return 1
  fi
  INSTANCE=$(yq -er '.deployments[strenv(DEPLOYMENT)].instance | select(. != "")' "$VALUES") || return 1
  NS=$(yq -er '.deployments[strenv(DEPLOYMENT)].namespace | select(. != "")' "$VALUES") || return 1
  RELEASE=$(yq -er '.deployments[strenv(DEPLOYMENT)].release | select(. != "")' "$VALUES") || return 1
  PACKAGE=$(yq -er '.deployments[strenv(DEPLOYMENT)].package | select(. != "")' "$VALUES") || return 1
  export PACKAGE
  PACKAGE_VERSION=$(yq -er '.packages[strenv(PACKAGE)].version | select(. != "")' "$VALUES") || return 1
  CHART_REF=$(yq -er '.packages[strenv(PACKAGE)].chart | select(. != "")' "$VALUES") || return 1
  INSTALL_DIR="$WORK_DIR/clusters/$CLUSTER_ID/applications/$INSTANCE"
  if [ "$DEPLOYMENT" != "$INSTANCE" ]; then
    INSTALL_DIR="$INSTALL_DIR/deployments/$DEPLOYMENT"
  fi
  if [ "$PWD" != "$INSTALL_DIR" ]; then
    printf 'Deployment %s requires directory %s, not %s\n' "$DEPLOYMENT" "$INSTALL_DIR" "$PWD" >&2
    return 1
  fi
  CHART="$WORK_DIR/packages/$PACKAGE/$PACKAGE_VERSION"
  export INSTANCE NS RELEASE PACKAGE_VERSION CHART_REF INSTALL_DIR CHART
}
